# Copy to .env (which is gitignored) and fill in real values.
# systemd's EnvironmentFile= loads this directly; for local runs, `set -a; source .env; set +a`.

LINE_CHANNEL_ACCESS_TOKEN=
LINE_TO_USER_ID=

# Optional: public HTTPS base URL where /tmp/alert.jpg is served from, so LINE
# can fetch it for image alerts. Leave unset for text-only alerts.
SNAPSHOT_PUBLIC_URL_BASE=
